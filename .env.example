# Set NODE_ENV=production in deployment (enables the prod config guards).
# NODE_ENV=production
DATABASE_PATH=./data/garde-manger.db
RP_ID=localhost
RP_NAME=Garde-Manger
ORIGIN=http://localhost:5173

# Open Food Facts (M3 — barcode scanning). Required in production: OFF mandates a
# descriptive User-Agent with a contact. In dev the .net staging host is used.
OFF_USER_AGENT="GardeManger/0.0.1 (you@example.com)"
# OFF_HOST=https://world.openfoodfacts.org
# PRODUCT_IMAGE_DIR=./data/product-images

# Web Push (M4 — daily notifications). REQUIRED in production.
# Generate a keypair with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for the daily cron endpoint (Coolify Scheduled Task sends it).
CRON_SECRET=
