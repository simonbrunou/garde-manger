{
	"name": "garde-manger",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": "26"
	},
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"start": "bun ./build/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run src/lib/server/seed/seed.ts",
		"db:backup": "bun run scripts/backup.ts",
		"test": "bun test ./src ./scripts",
		"test:watch": "bun test --watch ./src ./scripts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/web-push": "^3.6.4",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"playwright": "^1.65.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6"
	},
	"dependencies": {
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.0.3",
		"barcode-detector": "^3.2.3",
		"valibot": "^1.5.0",
		"web-push": "^3.6.7",
		"zxing-wasm": "^3.1.6"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
